#!/bin/sh
# pt35-quick — the radio switches behind the quick panel.
#
# nmcli and bluetoothctl have no "toggle", and the menu has no shell: it runs
# one command and shows what it prints on failure.
set -eu

usage() {
  echo "usage: pt35-quick wifi|bluetooth on|off|toggle" >&2
  echo "       pt35-quick bluetooth scan | connect MAC | disconnect MAC" >&2
  exit 2
}

[ $# -ge 2 ] || usage

case "$1" in
  wifi)
    command -v nmcli >/dev/null || { echo "nmcli is not installed" >&2; exit 1; }
    case "$2" in
      on|off) nmcli radio wifi "$2" ;;
      toggle)
        if [ "$(nmcli radio wifi)" = enabled ]; then
          nmcli radio wifi off
        else
          nmcli radio wifi on
        fi
        ;;
      *) usage ;;
    esac
    ;;
  bluetooth)
    command -v bluetoothctl >/dev/null || { echo "bluetoothctl is not installed" >&2; exit 1; }
    case "$2" in
      on|off) bluetoothctl power "$2" ;;
      toggle)
        if bluetoothctl show | grep -q "Powered: yes"; then
          bluetoothctl power off
        else
          bluetoothctl power on
        fi
        ;;
      # Twelve seconds of discovery, detached: the menu re-reads the list while
      # it runs, so devices appear as they are found.
      scan)
        bluetoothctl --timeout 12 scan on >/dev/null 2>&1 &
        ;;
      # Pair only what is not paired yet, and trust it so it reconnects on its
      # own next time. Run in a terminal: a keyboard asks for a PIN.
      connect)
        [ $# -eq 3 ] || usage
        if ! bluetoothctl info "$3" | grep -q "Paired: yes"; then
          bluetoothctl pair "$3"
        fi
        bluetoothctl trust "$3" >/dev/null
        bluetoothctl connect "$3"
        ;;
      disconnect)
        [ $# -eq 3 ] || usage
        bluetoothctl disconnect "$3" >/dev/null
        ;;
      *) usage ;;
    esac
    ;;
  *) usage ;;
esac
