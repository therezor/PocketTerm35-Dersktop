#!/usr/bin/env bash
# pt35-session — launched by greetd; sets the environment a 640x480 keyboard-only
# Wayland session needs, then execs sway.
set -u

export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=pt35
export XDG_CURRENT_DESKTOP=sway
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

# --- toolkit scaling -------------------------------------------------------
# The panel is 640x480 and stays at scale 1. An app that needs to shrink does it
# itself: pt35d passes its profile's scale as GDK_DPI_SCALE / QT_SCALE_FACTOR.
# These are the session-wide defaults it overrides.
export QT_QPA_PLATFORM=wayland
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
export QT_ENABLE_HIGHDPI_SCALING=0
export QT_FONT_DPI=96

export GDK_BACKEND=wayland,x11
export GDK_DPI_SCALE=1.0

export MOZ_ENABLE_WAYLAND=1
export MOZ_DBUS_REMOTE=1

export _JAVA_AWT_WM_NONREPARENTING=1
export SDL_VIDEODRIVER=wayland
export CLUTTER_BACKEND=wayland
export ELECTRON_OZONE_PLATFORM_HINT=wayland

# Small screen: keep terminal and GUI font sizes sane.
export XCURSOR_SIZE=16
export PT35_SHARE=/usr/share/pt35-desktop

# --- logs ------------------------------------------------------------------
LOG_DIR="${XDG_RUNTIME_DIR}/pt35"
mkdir -p "$LOG_DIR"

# sway leaves its sockets behind when it is killed, and a leftover wayland-N
# stops the next session from claiming the same name.
for sock in "$XDG_RUNTIME_DIR"/sway-ipc.*.sock; do
  [ -e "$sock" ] || continue
  pid=${sock##*.}; pid=${sock%.sock}; pid=${pid##*.}
  kill -0 "$pid" 2>/dev/null || rm -f "$sock"
done
for sock in "$XDG_RUNTIME_DIR"/wayland-[0-9]*; do
  [ -S "$sock" ] || continue
  fuser "$sock" >/dev/null 2>&1 || rm -f "$sock" "$sock.lock"
done

sway --unsupported-gpu >"$LOG_DIR/sway.log" 2>&1
status=$?

# sway's children are reparented to init when it exits, and logind keeps the old
# session scope alive while any of them run. A surviving pt35d holds the socket
# and the VT so the next session cannot start, and a client whose compositor
# vanished can spin on the dead socket at 100% CPU (imv does). Take the whole
# login session down with sway.
session_id=$(ps -o sess= -p "$$" 2>/dev/null | tr -d ' ')
leftovers() {
  [ -n "$session_id" ] || return 0
  ps -o pid= -s "$session_id" 2>/dev/null | tr -d ' ' | grep -v "^$$\$" || true
}
for signal in TERM KILL; do
  pids=$(leftovers)
  [ -n "$pids" ] || break
  # shellcheck disable=SC2086
  kill -"$signal" $pids 2>/dev/null || true
  sleep 1
done

exit "$status"
