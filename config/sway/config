# pt35-desktop — sway configuration for the Waveshare PocketTerm35 (640x480).
#
# Installed to /usr/share/pt35-desktop/sway/config and included from
# ~/.config/sway/config, so user overrides go after the include and win.
#
# VERIFY ON DEVICE (Phase 1): every directive here against `man 5 sway` for the
# installed sway version, and the output name against `swaymsg -t get_outputs`.

### ------------------------------------------------------------------ basics
set $mod Mod4
set $term foot
set $menu pt35ctl menu toggle
set $ctl  pt35ctl

# One panel. Name is usually HDMI-A-1 but the Pi 5 has two ports: match all.
output * {
    mode 640x480
    scale 1
    background #0a1310 solid_color
}

# 640x480 has no room for chrome: no borders, no gaps, no title bars.
default_border none
default_floating_border none
hide_edge_borders --i3 both
gaps inner 0
gaps outer 0
smart_borders on

# No mouse on this device. The cursor only exists in Mouse mode, where pt35d
# lifts the hide timeout.
focus_follows_mouse no
mouse_warping none
seat * hide_cursor 1500
seat * xcursor_theme default 16

# X11-only apps still need to work (they follow the output scale and look soft
# at fractional scales — prefer Wayland-native builds where they exist).
xwayland enable

font pango:DejaVu Sans 9

### ------------------------------------------------------------------- input
input type:keyboard {
    # 500ms before a held D-pad direction repeats, then 8 a second. Faster than
    # this and one press of the D-pad skips two tiles.
    repeat_delay 500
    repeat_rate 8
    xkb_options compose:menu
}

input type:touch {
    events enabled
}

### ------------------------------------------------------- window management
# Every app owns a workspace and is the only window on it: no tiling splits,
# no stacking to get lost in. 640x480 splits into two unusable halves, so pt35d
# moves any second window on a workspace to a free one instead of letting sway
# tile it. Workspace 1 is always a terminal.
workspace_layout default
for_window [shell=".*"] inhibit_idle fullscreen

# Dialogs and anything that insists on floating: centre and clamp on-screen.
for_window [floating] move position center
for_window [window_type="dialog"] resize set 600 420, move position center
for_window [window_type="menu"] move position center
no_focus [window_type="notification"]

### ----------------------------------------------------------------- startup
# Hand the session environment to systemd --user and dbus so that portals,
# notifications and user services see WAYLAND_DISPLAY.
exec_always --no-startup-id systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP SWAYSOCK
exec_always --no-startup-id dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP SWAYSOCK

exec --no-startup-id pt35d
exec --no-startup-id pt35-bar
exec --no-startup-id foot

### -------------------------------------------------------------- keybindings
# NOTE: the keyboard has a Super key of its own (row 6 of the matrix, next to
# the right Alt). The Alt fallbacks below are for a unit whose firmware does not
# send it.
#
# The six face buttons are bound by pt35d, not here: it drops them while the
# menu is open. See crates/pt35d/src/buttons.rs.

# Start (KEY_PAUSE) is the launcher. Select (KEY_SYSRQ) is the window manager:
# switch to a window or close it. Neither carries a character, so both are safe
# to grab while typing. A sway binding beats any surface, so Start closes the
# menu again from inside it.
#
# These two are bound here, not by pt35d, so that no mode can lose them.
bindsym Pause       exec $menu
bindsym $mod+space  exec $menu
bindsym Menu        exec $menu

bindsym Print       exec $ctl menu open windows
bindsym Sys_Req     exec $ctl menu open windows
bindsym $mod+w      exec $ctl menu open windows
bindsym $mod+m      exec $ctl mode toggle

# Fallbacks on Alt for a unit whose firmware does not send Super.
bindsym Mod1+space  exec $menu
bindsym Mod1+grave  exec $ctl window next
bindsym Mod1+Return exec $term
bindsym Mod1+Tab    workspace next_on_output

bindsym $mod+Return exec $term
bindsym $mod+q      kill
bindsym $mod+f      fullscreen toggle
bindsym $mod+t      floating toggle
# force an oversized window back on-screen
bindsym $mod+r      exec $ctl window fit
bindsym $mod+s      exec $ctl screenshot
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec $ctl power menu

# App switching: shoulder buttons (mapped to Prior/Next by keyd) and Tab.
bindsym $mod+Tab       workspace next_on_output
bindsym $mod+Shift+Tab workspace prev_on_output
bindsym $mod+Prior     workspace prev_on_output
bindsym $mod+Next      workspace next_on_output

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9

# Media / brightness keys (keyd maps the Fn row to these standard keysyms).
bindsym --locked XF86AudioRaiseVolume  exec $ctl volume +5
bindsym --locked XF86AudioLowerVolume  exec $ctl volume -5
bindsym --locked XF86AudioMute         exec $ctl volume mute
bindsym --locked XF86MonBrightnessUp   exec $ctl brightness +10
bindsym --locked XF86MonBrightnessDown exec $ctl brightness -10
bindsym --locked XF86PowerOff          exec $ctl power menu

# No swaybar: pt35-bar is our own layer-shell client.
